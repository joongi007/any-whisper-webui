# Copy to .env and edit.

# ─── api ─────────────────────────────────────────────────────────────────────
API_LOG_LEVEL=INFO
API_LOG_JSON=true
API_DEFAULT_BACKEND=faster_whisper
API_DEFAULT_MODEL=large-v3-turbo
API_DEFAULT_COMPUTE_TYPE=float16

# ─── ai ──────────────────────────────────────────────────────────────────────
AI_LOG_LEVEL=INFO
AI_LOG_JSON=true
AI_MODEL_IDLE_UNLOAD_SEC=300
AI_TRANSLATE_BATCH_SIZE=8
AI_TRANSLATE_BATCH_MAX_WAIT_MS=50

# Diarization (pyannote) requires a HuggingFace token AND accepting model terms:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
AI_HUGGINGFACE_TOKEN=

# Optional. If set, DeepL appears as a translation provider in the UI.
AI_DEEPL_API_KEY=
